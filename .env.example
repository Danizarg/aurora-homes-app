EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_URL=https://zouza.ai

# Suza voice & planning (optional). The app works fully without them:
# the deterministic planner runs on the device and voice input falls back to typing.
# Set to "true" once the website exposes POST /api/suza/plan (model-backed planning).
EXPO_PUBLIC_SUZA_REMOTE_PLANNER=false
# Set to "true" once the website exposes POST /api/suza/transcribe (speech-to-text for iOS/Android).
EXPO_PUBLIC_SUZA_TRANSCRIBE=false
