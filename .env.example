EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_URL=https://zouza.ai

# ---- Suza voice & planning (server side, never bundled into the app) ----
# These power the Expo API routes in app/api/suza/*. In development the dev server
# (npx expo start, also through --tunnel) serves them to the phone; in production
# deploy the web export (EAS Hosting) and set EXPO_PUBLIC_SUZA_API_URL below.
#
# Speech-to-text for iOS/Android: any OpenAI-compatible transcription endpoint.
SUZA_STT_API_KEY=
# SUZA_STT_URL=https://api.openai.com/v1/audio/transcriptions
# SUZA_STT_MODEL=gpt-4o-mini-transcribe
#
# Suza's spoken voice. With an ElevenLabs key she speaks with the voice chosen from their
# library; without one, the OpenAI voice below is used, and with neither, device speech.
# Either way the server softens her S and Z sounds and adds the echo and stereo space.
ELEVENLABS_API_KEY=
# SUZA_ELEVENLABS_VOICE_ID=KpTQ5yzwazQWLkvnK59A
# SUZA_ELEVENLABS_MODEL=eleven_multilingual_v2
# SUZA_TTS_PROVIDER=             # "openai" or "elevenlabs" to force one
#
# OpenAI-compatible text-to-speech (same key as transcription above by default).
# SUZA_TTS_API_KEY=
# SUZA_TTS_VOICE=sage            # e.g. ash or onyx for a deeper, more "Jarvis" register
# SUZA_TTS_MODEL=gpt-4o-mini-tts
# SUZA_TTS_INSTRUCTIONS=         # how she should sound, in words
#
# Model-backed understanding (Claude). Without it Suza uses the on-device parser.
ANTHROPIC_API_KEY=
# SUZA_PLAN_MODEL=claude-opus-5-5
#
# Where the app finds those routes in production (dev finds the dev server by itself).
EXPO_PUBLIC_SUZA_API_URL=
# Set to "false" to force the on-device parser even when the server planner is configured.
EXPO_PUBLIC_SUZA_REMOTE_PLANNER=
