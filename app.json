{
  "expo": {
    "name": "Zouza",
    "slug": "zouza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zouza",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.zouza.app"
    },
    "android": {
      "package": "ai.zouza.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF9FC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9FC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zouza needs access to your photos so Suzi can write your listing from them."
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {}
    }
  }
}
