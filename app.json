{
  "expo": {
    "name": "Aurora Homes",
    "slug": "aurora-homes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aurorahomes",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurorahomes.app"
    },
    "android": {
      "package": "com.aurorahomes.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7EE",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aurora Homes needs access to your photos so Aurora can generate a professional listing from them."
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
